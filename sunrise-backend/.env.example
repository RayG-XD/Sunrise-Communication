# Django Backend Environment Configuration Template
# Copy this file to .env and configure values for production deployment

# Security
SECRET_KEY=your-secure-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,sunrisecommunication.in,api.sunrisecommunication.in

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://sunrisecommunication.in

# Database (Default is SQLite, optional PostgreSQL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/sunrise_db

# Email / SMTP Configuration (for lead notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sunrisecommunication.thane@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Sunrise Communication <sunrisecommunication.thane@gmail.com>
NOTIFICATION_RECIPIENT_EMAIL=sunrisecommunication.thane@gmail.com
