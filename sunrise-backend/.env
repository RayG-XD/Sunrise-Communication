# Sunrise Communication Backend - Environment Variables
# Copy this file as .env and fill in your values

# Django Settings
SECRET_KEY=change-me-to-a-strong-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# For local dev with SQLite (no PostgreSQL needed initially):
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (uncomment when ready):
# DATABASE_URL=postgres://sunrise_user:password@localhost:5432/sunrise_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000

# Media Files
MEDIA_URL=/media/
